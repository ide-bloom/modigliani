      "properties": {
        "source": {
          "description": "Expression such as req.body.power or req.fields.temp",
          "title": "Source",
          "type": "string"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        },
        "scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "value_map": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device value (as JSON text) -> state value",
          "title": "Value Map"
        }
      },
      "required": [
        "source",
        "variable"
      ],
      "title": "Extract",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
