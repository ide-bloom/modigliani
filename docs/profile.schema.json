    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mqtt": {
          "anyOf": [
            {
              "$ref": "#/$defs/MqttAuth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "CaptureRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "mode"
      ],
      "title": "CaptureRef",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "sum8",
            "xor8",
            "crc8",
            "sum16",
            "crc16_ccitt",
            "crc16_modbus",
            "crc32"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "offset": {
          "description": "Position of the checksum; negative counts from the end",
          "title": "Offset",
          "type": "integer"
        },
        "start": {
          "default": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "default": 0,
          "description": "Exclusive end of covered bytes; <=0 counts from the end",
          "title": "End",
          "type": "integer"
        },
        "endian": {
          "default": "big",
          "enum": [
            "big",
            "little"
          ],
          "title": "Endian",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "offset"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "CoapHandler": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity"
        },
        "request_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Frame"
        },
        "extract": {
          "items": {
            "$ref": "#/$defs/Extract"
          },
          "title": "Extract",
          "type": "array"
        },
        "response": {
          "$ref": "#/$defs/CoapResponseSpec"
        },
        "housekeeping": {
          "anyOf": [
            {
              "enum": [
                "time_sync",
                "firmware_check"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Housekeeping"
        },
        "polling_interval_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polling Interval S"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "method",
        "path"
      ],
      "title": "CoapHandler",
      "type": "object"
    },
    "CoapResponseSpec": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "default": "2.05",
          "title": "Code",
          "type": "string"
        },
        "content_format": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Format"
        },
        "payload_type": {
          "default": "empty",
          "enum": [
            "empty",
            "json",
            "text",
            "frame"
          ],
          "title": "Payload Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/FramePayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CoapResponseSpec",
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        },
        "transport": {
          "enum": [
            "http_poll",
            "mqtt",
            "coap_response",
            "websocket",
            "raw"
          ],
          "title": "Transport",
          "type": "string"
        },
        "handler": {
          "description": "id of the HTTP handler, MQTT topic, CoAP/WS/raw handler",
          "title": "Handler",
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/JsonValue",
          "default": null,
          "description": "Item/payload template; uses cmd.*"
        },
        "value_map": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "State value (as JSON text) -> device value",
          "title": "Value Map"
        },
        "scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "device value = state value / scale",
          "title": "Scale"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name",
        "variable",
        "transport",
        "handler"
      ],
      "title": "Command",
      "type": "object"
    },
    "CommandDelivery": {
      "additionalProperties": false,
      "description": "How pending commands are embedded into a polled response.",
      "properties": {
        "mode": {
          "default": "list",
          "enum": [
            "list",
            "replace"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "description": "Dotted path in the response body; '' for the whole body",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "CommandDelivery",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "http": {
          "$ref": "#/$defs/HttpResponseSpec"
        },
        "coap_code": {
          "default": "2.05",
